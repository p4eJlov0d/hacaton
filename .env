# Настройка обновления схемы бд. none, чтобы выключить
DDL_AUTO=update

# PostgreSQL
POSTGRES_DATABASE=news
POSTGRES_PASSWORD=user
POSTGRES_USER=user
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/news

# Внешний порт
APP_PORT=8080
# Начальный URI, от которого идут остальные эндпоинты
CONTEXT_PATH=/api
# Включить/Выключить Swagger
SWAGGER_ENABLED=true

# News API
GNEWS_URL=https://gnews.io/api/v4/search
GNEWS_URI_VARIABLES='q=ключевая ставка&lang=ru&country=ru&max=10&in=title,description,content'
# Опрос каждые 15 минут
GNEWS_POLL=900000

AI_API_URL=https://changellenge.up.railway.app/v1
AI_MODEL=deepseek/deepseek-v4.1-flash

AI_API=
GNEWS_API=